# ════════════════════════════════════════════════════════════════════════════
# KIAN — نموذج متغيّرات البيئة   ·   Wave 0 · V2-0.3-B
# الدليل الكامل: docs/ENVIRONMENTS.md
#
# ⛔ ملف **أسماء فقط**. لا قيمة حقيقية هنا إطلاقًا — الملف مُلتزَم في Git (G5).
#    القيم تعيش في Vercel → Settings → Environment Variables، ومحليًا في
#    `.env.local` (المستثنى من Git).
#
# ★ وسم النطاق — أُضيف في Wave 0 ★
#   [P]  Production فقط        [V]  Preview فقط
#   [PV] الاثنان بقيم **مختلفة**    [L]  محلي فقط
#
# 🔴 القاعدة الحاكمة: كل متغيّر معلَّم [PV] يجب أن يحمل **قيمة مختلفة** في
#    Preview عن Production. صفّ واحد في Vercel يشمل البيئتين = البيئتان
#    تتحدّثان إلى **نفس القاعدة**، وكل اختبار Preview يكتب على بيانات عملاء
#    حقيقية. طريقة الإثبات: docs/GATE_A_VERIFICATION_PACK.md §٤.
#
# 🔴 الأخطر ليس القاعدة وحدها: مفاتيح Zoho وWhatsApp وn8n المشتركة تعني أن
#    نشرة تجريبية قد تُصدر **فاتورة حقيقية** أو ترسل **واتساب لعميل حقيقي**.
#    القاعدة معزولة لا تكفي — الآثار الجانبية الخارجية تُعزل أيضًا.
#
# ⚠️ القيم الافتراضية أدناه مقصودة. اقرأ التعليق فوق كل متغيّر قبل تغييره —
#    وبالأخص PROJECT_EMAIL_ALERTS_ENABLED (فخّ opt-out موثَّق).
# ════════════════════════════════════════════════════════════════════════════

# ── Supabase — Client Portal (بوابة العملاء) ────────────────────────────
# 🔴 [PV] — هذان المتغيّران ومعهما SUPABASE_URL و SUPABASE_SERVICE_ROLE_KEY
#    أدناه هم الفرق بين بيئة اختبار حقيقية ووهم العزل.
# Get both values from: Supabase Dashboard → Project Settings → API
#
# Local development: copy this file to .env.local and fill in the values.
# Production (Vercel): add the same two variables under
#   Project → Settings → Environment Variables, then redeploy.
#
# Note: the URL is the project base URL only — do NOT append /rest/v1 or /auth/v1.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── WhatsApp Inbox ingest (SERVER-ONLY — never NEXT_PUBLIC) ──────────────
# Shared secret n8n must send in the `x-kian-ingest-secret` header.
# Generate a long random value (e.g. `openssl rand -hex 32`).
N8N_WHATSAPP_INGEST_SECRET=

# Supabase service-role key — used ONLY by the server ingest route to call the
# whatsapp_ingest_message RPC. NEVER expose to the browser. From Supabase
# Dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: server-side project URL. Falls back to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# ── WhatsApp outbound send (SERVER-ONLY — reply from portal) ─────────────
# DRY-RUN by default: replies are recorded in the conversation but NOT sent
# until WHATSAPP_SEND_ENABLED=true AND the token+phone id are set. Do NOT enable
# on the LIVE number until the flow is reviewed (Checkpoint ب).
WHATSAPP_SEND_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Comma-separated phone numbers allowed to receive REAL sends while testing.
# When set AND WHATSAPP_SEND_ENABLED=true, any number NOT in this list is BLOCKED
# (recorded, not sent). Leave empty for no extra gate (production-wide send).
WHATSAPP_SEND_TEST_ALLOWLIST=

# ── AI Agent (gated — SERVER-ONLY; NOT attached to live customers) ──────
# All OFF/draft by default. AI never auto-replies to live numbers. When enabled,
# it only drafts suggestions (AI_DRAFT_ONLY=true) and is limited to AI_TEST_ALLOWLIST.
AI_AGENT_ENABLED=false
AI_DRAFT_ONLY=true
AI_PROVIDER=claude
AI_API_KEY=
AI_TEST_ALLOWLIST=

# ── WhatsApp email alerts (SERVER-ONLY; department-scoped) ───────────────
# DISABLED by default. When 'true', a new WhatsApp message emails owner/admin/
# manager + the relevant department only. Reuses the existing Apps Script channel
# (no SMTP keys here) — the Apps Script must handle Event "whatsapp_new". Email
# failure never blocks ingest.
WHATSAPP_EMAIL_ALERTS_ENABLED=false
# Optional override for the notify endpoint (defaults to the Apps Script URL).
PORTAL_NOTIFY_ENDPOINT=
# Optional public base for links in emails (defaults to https://www.kianmedia.com).
PORTAL_PUBLIC_URL=

# ── Internal staff WhatsApp alerts (gated — keep OFF) ───────────────────
# Schema/settings exist (whatsapp_staff_alert_settings). NO real staff WhatsApp
# alerts are sent unless enabled AND the staff alert phone is allow-listed.
WHATSAPP_STAFF_ALERTS_ENABLED=false
WHATSAPP_INTERNAL_ALERTS_ENABLED=false
WHATSAPP_INTERNAL_ALERTS_TEST_ALLOWLIST=

# ── Start-new-conversation / WhatsApp templates (gated — keep OFF) ───────
# Starting a chat with a new number requires an approved Meta template. All OFF
# by default; template sends restricted to the allowlist when enabled.
WHATSAPP_START_CONVERSATION_ENABLED=false
WHATSAPP_TEMPLATE_SEND_ENABLED=false
WHATSAPP_TEMPLATE_TEST_ALLOWLIST=

# ── Auto quote-link reply on price intent (rule-based, gated — keep OFF) ──
# When an inbound message asks about price/quote/cost, optionally auto-reply with a
# quote-request link. OFF by default; dry-run logs an internal note without sending;
# allowlist restricts real sends; cooldown avoids spamming the same conversation.
WHATSAPP_AUTO_QUOTE_LINK_ENABLED=false
WHATSAPP_AUTO_QUOTE_LINK_DRY_RUN=true
WHATSAPP_AUTO_QUOTE_LINK_TEST_ALLOWLIST=
WHATSAPP_AUTO_QUOTE_LINK_COOLDOWN_HOURS=6

# ── Customer confirmation after a WhatsApp quote submission (gated — keep OFF) ─
# Email goes through the Apps Script channel (Event "quote_received"); WhatsApp is a
# free-form session message restricted to the allowlist. Both non-blocking + OFF.
QUOTE_REQUEST_CUSTOMER_EMAIL_ENABLED=false
QUOTE_REQUEST_CUSTOMER_WHATSAPP_CONFIRM_ENABLED=false
QUOTE_REQUEST_CUSTOMER_WHATSAPP_CONFIRM_TEST_ALLOWLIST=

# ── WhatsApp inbox client-side debug logging (safe; no secrets) ──────────
# Logs (browser console) the selected conversation id + quote-request count +
# any query error. Auto-on in local dev; set to 1 to also see it on Vercel
# Preview (NODE_ENV is "production" there). Leave blank in Production.
NEXT_PUBLIC_WA_DEBUG=

# ── Zoho CRM — Saudi Arabia (.sa) data center (SERVER-ONLY) ──────────────
# When unset, WhatsApp→Zoho lead sync is a safe no-op (ingest still succeeds).
# IMPORTANT: client id/secret + refresh token must be minted on the .sa DC
# (accounts.zoho.sa). A US-DC secret yields invalid_client; a US token used on
# the .sa API yields INVALID_TOKEN. Note hosts: accounts = no "www", api = "www".
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.sa
# Fallback base; at runtime the token response's api_domain (https://www.zohoapis.sa) is preferred.
ZOHO_CRM_API_BASE=https://www.zohoapis.sa/crm/v5

# ── Zoho Books — DRAFT estimates only (SERVER-ONLY, gated — keep OFF) ────────
# Creates a DRAFT عرض سعر / تقدير only. NEVER sends estimates, NEVER creates
# invoices, NEVER issues ZATCA e-invoices. Reuses the shared ZOHO_* OAuth app
# (the refresh token's scope must include ZohoBooks.estimates.CREATE +
# ZohoBooks.contacts.*). Off by default; draft-only guard defaults true.
ZOHO_BOOKS_ESTIMATES_ENABLED=false
ZOHO_BOOKS_ESTIMATE_DRAFT_ONLY=true
ZOHO_BOOKS_ORGANIZATION_ID=
# Optional overrides (defaults shown). VAT tax id is only applied if set.
ZOHO_BOOKS_API_BASE=https://www.zohoapis.sa/books/v3
ZOHO_BOOKS_VAT_TAX_ID=

# ─── Zoho Books full sync (Batch 8 — project accounting → Books) ───
# Server-only. Modes: disabled (default) | dry_run | live. Live requires mappings.
ZOHO_BOOKS_SYNC_MODE=disabled
ZOHO_BOOKS_WEBHOOK_SECRET=
# Optional dedicated credentials (fallback to shared ZOHO_* above):
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
ZOHO_BOOKS_REFRESH_TOKEN=
ZOHO_ACCOUNTS_BASE=
# ─── Project Core email engine (Batch 7) ───
# ⚠️ LEAVE THIS EMPTY. The channel is opt-OUT: lib/server/projectNotify.ts:24 disables
# email only when the value is the literal string "false". This file used to ship
# `PROJECT_EMAIL_ALERTS_ENABLED=false`, so anyone who copied .env.example verbatim
# darkened the entire project email channel — reintroducing the exact Batch 9D defect
# that projectNotify.ts:9-12 was written to fix. Unset (or any value other than
# "false") = enabled, which is what production wants.
PROJECT_EMAIL_ALERTS_ENABLED=

# ─── Notification / email channel (server-only; names only, never commit values) ───
# CRON_SECRET — REQUIRED. /api/cron/notify-email, /api/cron/custody-alerts and
#   /api/cron/zoho-sync all fail closed with HTTP 500 when it is unset.
# PORTAL_NOTIFY_ENDPOINT — the Apps Script /exec Web App URL used for portal email.
#   When unset, every sender silently falls back to the hardcoded public constant
#   SHEETS_ENDPOINT (lib/submitForm.ts) that also serves the public marketing forms.
# PORTAL_PUBLIC_URL — base for links inside emails (defaults to https://www.kianmedia.com).
# CUSTODY_EMAIL_ALERTS_ENABLED / HR_EMAIL_ALERTS_ENABLED — same opt-out shape as above.
CRON_SECRET=
PORTAL_NOTIFY_ENDPOINT=
PORTAL_PUBLIC_URL=
CUSTODY_EMAIL_ALERTS_ENABLED=
HR_EMAIL_ALERTS_ENABLED=

# ════════════════════════════════════════════════════════════════════════════
# Wave 0 · V2-0.3-B — متغيّرات يقرأها الكود وكانت غائبة عن هذا الملف
#
# رُصدت بمقارنة `grep -o 'process\.env\.[A-Z0-9_]*'` على app/ lib/ components/
# apps/ مقابل محتوى هذا الملف. غيابها هنا يعني أن أي شخص يجهّز بيئة جديدة
# ينساها بصمت، فتظهر أعطالها بعد النشر لا قبله.
# ════════════════════════════════════════════════════════════════════════════

# ─── عناوين الموقع ──────────────────────────────────────────────────────────
# lib/site.ts يشتقّ منه canonical و sitemap و robots. في Preview يجب أن يكون
# عنوان النشرة التجريبية، وإلا أعلنت النشرة عن نفسها بعنوان الإنتاج.
NEXT_PUBLIC_SITE_URL=              # [PV]
NEXT_PUBLIC_PORTAL_URL=            # [PV]

# ─── قناة البريد الموحّدة (Communications Hub) ──────────────────────────────
COMMS_RELAY_SIGNING_SECRET=              # [PV]
COMMS_LEGACY_RELAY_ENABLED=              # [PV]
COMMS_LEGACY_SENDERS_ENABLED=            # [PV]
NEXT_PUBLIC_COMMS_LEGACY_NOTIFY_ENABLED= # [PV]

# ─── n8n ────────────────────────────────────────────────────────────────────
# ⚠️ [P]: توجيه Preview إلى نفس الـwebhook يعني أن نشرة تجريبية تُشغّل أتمتة
#    حقيقية. اتركه فارغًا في Preview.
N8N_NOTIFY_WEBHOOK_URL=            # [P]
N8N_NOTIFY_SECRET=                 # [PV]

# ─── أملاح البصمات ──────────────────────────────────────────────────────────
# 🔴 [PV] إلزامًا: ملح مشترك بين البيئتين يجعل بصمة الزائر على Preview مطابقة
#    لبصمته على Production — ربط عبر البيئات لا يجوز.
LIVE_STATUS_FP_SALT=               # [PV]
SECURE_DOCUMENT_FP_SALT=           # [PV]
AI_PUBLIC_FP_SALT=                 # [PV]

# ─── Zoho — متغيّران إضافيان يقرأهما الكود (🔒 G7 مجمَّد) ───────────────────
ZOHO_ORGANIZATION_ID=              # [P]
ZOHO_API_BASE_URL=                 # [P]
ZOHO_ACCOUNTS_BASE_URL=            # [P]

# ─── تطبيق الجوال (Expo) ────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=          # [PV]
EXPO_PUBLIC_SUPABASE_ANON_KEY=     # [PV]
EAS_PROJECT_ID=                    # [PV]

# ─── أدوار ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ORG_ADMIN_ROLE_ENABLED=   # [PV] الافتراضي OFF

# ════════════════════════════════════════════════════════════════════════════
# Wave 0 — متغيّرات جديدة أضافتها هذه الموجة
# السجلّ الموحّد للأعلام: docs/FEATURE_FLAG_REGISTRY.md (G6)
# ════════════════════════════════════════════════════════════════════════════

# ─── V2-0.5-A · المراقبة ────────────────────────────────────────────────────
# 🔴 غير مضبوط على أي بيئة اليوم. بدونه lib/observability.ts يعمل بلا ناقل —
#    يسجّل سطرًا منظَّمًا مُنقَّحًا فقط ولا يدّعي أكثر من ذلك.
#    خطوات التركيب الكاملة: docs/OBSERVABILITY.md
SENTRY_DSN=                        # [PV] الوجود وحده يُفعّل الإرسال

# ─── V2-0.1 · checkbox الموافقة على سياسة الخصوصية ──────────────────────────
# غير مضبوط = OFF، والنماذج الأربعة تبقى **كما هي حرفيًا** (شرط G6).
# ⛔ لا تُفعِّله قبل تشغيل docs/consent_capture_EXTENSION_RUNME.sql — وإلا ظهر
#    الـcheckbox وأُلزم الزائر به بينما الموافقة لا تُحفَظ (يُسجَّل في السجلّ
#    بوسم PUBLIC_INTAKE_CONSENT_NOT_RECORDED، ولا يُفقد الطلب نفسه).
NEXT_PUBLIC_CONSENT_CHECKBOX_ENABLED=   # [PV] "true" للتفعيل

# ─── V2-1.5 · قسم آراء العملاء ──────────────────────────────────────────────
# غير مضبوط = OFF، والقسم **لا يُعرض إطلاقًا**. القسم الفارغ الذي رصده الفحص
# الخارجي زال بذلك. ⛔ لا تُفعّله قبل وجود مصدر بيانات معتمَد — تفعيله اليوم
# يعرض الحالة الفارغة نفسها.
NEXT_PUBLIC_SHOW_TESTIMONIALS=          # [PV] "true" للتفعيل

# ─── V2-1.11 · صفحات SEO (٦ خدمات + ٣ مدن، عربي/إنجليزي) ────────────────────
# غير مضبوط = OFF: المسارات تُرجع 404، ولا تدخل sitemap، ولا يربط بها التنقل.
# ⛔ لا تُفعّله قبل مراجعة نصوصها (PENDING KHALED CONTENT REVIEW).
NEXT_PUBLIC_SHOW_SEO_PAGES=             # [PV] "true" للتفعيل

# ─── V2-2.3 · صفحة الثقة والامتثال (/trust · /en/trust) ─────────────────────
# غير مضبوط = OFF: المساران يُرجعان 404، ولا يدخلان sitemap، ولا يُصدَر لهما
# canonical أو hreflang، ولا يتسرّب نصّ الصفحة إلى HTML العام.
# ⛔ لا تُفعّله قبل: (١) مراجعة خالد لنصوص الصفحة — PENDING KHALED REVIEW،
#    (٢) مطابقة السجل التجاري والرقم الضريبي على الشهادتين الرسميتين —
#        PENDING OFFICIAL DOCUMENT VERIFICATION (content/registration.ts).
# ملاحظة: الرقمان لا يظهران حتى مع تفعيل هذا العلم — لهما بوّابة مستقلّة.
NEXT_PUBLIC_SHOW_TRUST_PAGE=            # [PV] "true" للتفعيل

# ─── V2-3.1 · الضوء والطقس على ورقة النداء (مركز التشغيل) ───────────────────
# غير مضبوط = OFF: ورقة النداء تبقى **كما هي حرفيًّا**، ولا يُصدر مسار الطقس
# طلبًا واحدًا (ويُرجع 404 فلا يُقرّ بوجوده).
# ⛔ لا تُفعّله قبل تطبيق docs/wave3_production_ops_RUNME.sql — قبله لا وجود
#    لأعمدة wind_gust_kph / fetched_at / is_drone_day / backup_date.
# ملاحظة: الساعة الذهبية حساب محلّيّ بحت — لا شبكة ولا مفتاح.
NEXT_PUBLIC_SHOW_OPS_SUN_WEATHER=       # [PV] "true" للتفعيل

# ─── V2-3.6 · تغذية تقويم أيام التصوير (ICS برمز قابل للإلغاء) ──────────────
# غير مضبوط = OFF: /api/calendar/<token> يُرجع 404 دائمًا.
# ⛔ لا تُفعّله قبل تطبيق docs/wave3_calendar_tokens_RUNME.sql.
# 🔴 هذه الحزمة تمنح anon تنفيذ دالّة واحدة (prodops_calendar_feed). راجع
#    POSTCHECK §«anon يملك prodops_calendar_feed فقط» قبل التفعيل.
NEXT_PUBLIC_ENABLE_OPS_CALENDAR_FEED=   # [PV] "true" للتفعيل

# ─── V2-3.2-A / V2-3.4-B · سجلّ التصاريح ووسائط التشغيل ─────────────────────
# غير مضبوط = OFF: التبويب **غير موجود** في مركز التشغيل، ولا يُستدعى أيّ RPC،
# و/api/portal/ops/media-url يُرجع 404.
# ⛔ لا تُفعّله قبل تطبيق docs/wave3_permits_media_RUNME.sql.
# ملاحظة: الجدولان يُنشآن **فارغين** — لا تصاريح مخترعة. أوّل ما تراه حالة فارغة.
NEXT_PUBLIC_SHOW_OPS_PERMITS_REGISTRY=  # [PV] "true" للتفعيل

# ─── Wave 4 · مؤشّرات الأعمال في CRM (فوز · موسمية · صحّة العميل) ───────────
# غير مضبوط = OFF: التبويب **غير موجود** في مركز CRM، ولا يُستدعى أيّ RPC،
# والملخّص الأسبوعي لا يُبنى داخل /api/cron/notify-email.
# ⛔ لا تُفعّله قبل تطبيق docs/wave4_crm_business_RUNME.sql.
# ملاحظة: الهامش يبقى محجوبًا حتى مع تفعيل هذا العلم — بوّابته can_see_financials().
NEXT_PUBLIC_SHOW_CRM_WAVE4=             # [PV] "true" للتفعيل

# ─── Wave 5 · حقوق العرض التسويقيّ وروابط التسليم ───────────────────────────
# غير مضبوط = OFF: لا لوحة في تبويب المخرَجات، ولا استدعاء RPC.
# ⛔ لا تُفعّله قبل تطبيق docs/wave5_delivery_rights_RUNME.sql.
# 🔴 الحزمة تمنح anon دالّة واحدة (delivery_link_check) لفتح رابط التسليم بلا
#    جلسة. راجع POSTCHECK «anon يملك delivery_link_check فقط» قبل التفعيل.
NEXT_PUBLIC_SHOW_DELIVERY_RIGHTS=       # [PV] "true" للتفعيل

# ─── Wave 5 · الموافقة الحكمية (Deemed Approval) ────────────────────────────
# 🔴🔴 غير مضبوط = OFF، ويبقى OFF حتى يُحدَّد نصّ البند الموقَّع لكلّ مشروع (W5-3).
# البنية وحدها مبنيّة: التفعيل **لكلّ مشروع** في deemed_approval_config ويوجب
# بندًا ومرجع عقد ودليلًا ومهلة وبداية سريان. ⛔ لا تفعيل عامّ · لا أثر رجعيّ.
NEXT_PUBLIC_SHOW_DEEMED_APPROVAL=       # [PV] "true" للتفعيل
# ─── Wave 6 · سجلّات السلامة والإجراءات والحقوق ─────────────────────────────
# غير مضبوط = OFF: التبويب **غائب** من القائمة، والصفحة تقول «غير مُفعَّلة»،
# ولا يُستدعى أيّ RPC.
# ⛔ لا تُفعّله قبل تطبيق:
#      docs/wave6_assets_archive_RUNME.sql
#      docs/wave6_compliance_knowledge_RUNME.sql
# ملاحظة: صفحة /e/<token> لا تحكمها هذه الراية — حارسها تسجيل الدخول نفسه
#         وفق docs/QR_SECURITY_CONTRACT.md (لا مسح مجهول الهوية في V1).
NEXT_PUBLIC_SHOW_WAVE6_REGISTERS=       # [PV] "true" للتفعيل

# ─── V2-6.8 · مسوّدات دراسات الحالة (داخل منصّة cs_* القائمة) ───────────────
# غير مضبوط = OFF: لا شاشة · لا توليد · لا استدعاء · لا معالجة خلفية.
# ⛔ لا تُفعّله قبل تطبيق docs/wave6_case_study_generator_RUNME.sql.
# 🔴 التصدير **سكربت تطوير/CI** (scripts/export-case-studies.mjs) — ولا يعمل
#    داخل بيئة نشر إطلاقًا: نظام ملفّات Vercel للقراءة، والكتابة تُفقد عند أوّل
#    نشر. القاعدة تسجّل أنّ التصدير حدث ولا تنفّذه.
NEXT_PUBLIC_SHOW_CASE_STUDY_DRAFTS=     # [PV] "true" للتفعيل

# ─── Wave 7 · V2-7.1 · البحث الشامل (Cmd/Ctrl+K) ────────────────────────────
# غير مضبوط = OFF: لا مكوّن · لا مستمع لوحة مفاتيح · لا طلب شبكة.
# ⛔ لا تُفعّله قبل تطبيق docs/wave7_global_search_RUNME.sql.
# ملاحظة: التصفية حسب الصلاحية تقع **داخل استعلام القاعدة** لا في المتصفّح،
#         ولا يُعاد مبلغ ولا هاتف ولا مسار تخزين في أيّ نتيجة.
NEXT_PUBLIC_SHOW_GLOBAL_SEARCH=         # [PV] "true" للتفعيل

# ─── Wave 7 · V2-7.3 · عارض سجلّ التدقيق (قراءة فقط) ────────────────────────
# غير مضبوط = OFF: لا شاشة ولا استدعاء.
# ⛔ لا تُفعّله قبل تطبيق docs/wave7_audit_viewer_RUNME.sql.
# 🔴 العارض يقرأ activity_log **وحده**، ويُسمّي بقيّة سجلّات الوحدات صراحةً —
#    قرار متحفّظ مسجَّل بوصفه W7-1، لأنّ توحيد خمسة عشر سجلًّا مختلف الشكل
#    يُنتج عرضًا يبدو كاملًا وهو ليس كذلك.
NEXT_PUBLIC_SHOW_AUDIT_VIEWER=          # [PV] "true" للتفعيل

# ════════════════════════════════════════════════════════════════════════════
# أسرار **لا** تعيش هنا — تُضبط في GitHub (Settings → Secrets → Actions)
# للنسخ الاحتياطي (.github/workflows/db-backup.yml · V2-0.4-A):
#   SUPABASE_DB_URL · BACKUP_S3_BUCKET · BACKUP_S3_ACCESS_KEY_ID
#   BACKUP_S3_SECRET_ACCESS_KEY · BACKUP_S3_REGION
# ════════════════════════════════════════════════════════════════════════════

# ── Wave 8 · V2-8.3-B — قناة Expo Push ───────────────────────────────────────
# 🔴 مطفأة ما لم تكن القيمة "1" بالضبط. أيّ قيمة أخرى — أو الغياب — تعني مطفأة.
# ⛔ ليست NEXT_PUBLIC_: الإرسال خادميّ، ولا سبب لتسريب حالته إلى حزمة المتصفّح.
PUSH_EXPO_ENABLED=                 # [PV]
# اعتماد Expo — ⛔ لا يُكتب في المستودع إطلاقًا، ويُضبط في بيئة الخادم وحدها.
EXPO_ACCESS_TOKEN=                 # [PV]
